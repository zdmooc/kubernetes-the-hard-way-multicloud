Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-22.04"

  machines = {
    "jumpbox"      => { ip: "192.168.56.10", cpus: 2, memory: 2048 },
    "controller-0" => { ip: "192.168.56.11", cpus: 2, memory: 3072 },
    "controller-1" => { ip: "192.168.56.12", cpus: 2, memory: 3072 },
    "controller-2" => { ip: "192.168.56.13", cpus: 2, memory: 3072 },
    "worker-0"     => { ip: "192.168.56.21", cpus: 2, memory: 3072 },
    "worker-1"     => { ip: "192.168.56.22", cpus: 2, memory: 3072 }
  }

  machines.each do |name, spec|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: spec[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = "kthw-#{name}"
        vb.cpus = spec[:cpus]
        vb.memory = spec[:memory]
      end

      node.vm.provision "shell", inline: <<-SHELL
        set -eux
        swapoff -a || true
        sed -ri '/\sswap\s/s/^#?/#/' /etc/fstab || true
        modprobe overlay || true
        modprobe br_netfilter || true
        cat >/etc/modules-load.d/k8s.conf <<MODS
overlay
br_netfilter
MODS
        cat >/etc/sysctl.d/99-kubernetes-cri.conf <<SYSCTL
net.bridge.bridge-nf-call-iptables = 1
net.ipv4.ip_forward = 1
net.bridge.bridge-nf-call-ip6tables = 1
SYSCTL
        sysctl --system || true
        apt-get update
        apt-get install -y curl wget ca-certificates socat conntrack ipset iptables arptables ebtables ethtool vim jq bash-completion
      SHELL
    end
  end
end

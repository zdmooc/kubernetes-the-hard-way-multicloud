# === Kubernetes The Hard Way - Inventory Example ===
# Provider: Azure
# Ce fichier est un exemple. Le fichier réel (inventory.env) 
# est généré automatiquement par Terraform lors du provisionnement.

PROVIDER="azure"
REGION="westeurope"
ZONE="none"

# IPs Publiques (remplacées par Terraform)
JUMPBOX_PUBLIC_IP="20.x.x.x"
SERVER_PUBLIC_IP="20.x.x.x"
NODE_0_PUBLIC_IP="20.x.x.x"
NODE_1_PUBLIC_IP="20.x.x.x"

# IPs Privées (fixes selon l'architecture)
JUMPBOX_PRIVATE_IP="10.240.0.10"
SERVER_PRIVATE_IP="10.240.0.11"
NODE_0_PRIVATE_IP="10.240.0.20"
NODE_1_PRIVATE_IP="10.240.0.21"

# Configuration Réseau Kubernetes
POD_CIDR="10.200.0.0/16"
NODE_0_POD_CIDR="10.200.0.0/24"
NODE_1_POD_CIDR="10.200.1.0/24"
SERVICE_CIDR="10.32.0.0/24"
CLUSTER_DNS="10.32.0.10"

# Versions des composants
KUBERNETES_VERSION="1.29.2"
ETCD_VERSION="3.5.12"
CONTAINERD_VERSION="1.7.13"
CNI_VERSION="1.4.0"
RUNC_VERSION="1.1.12"

# Accès SSH
SSH_USER="ubuntu"
SSH_KEY_PATH="~/.ssh/id_ed25519"
